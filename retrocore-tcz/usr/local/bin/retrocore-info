#!/bin/sh
# retrocore-info - banner di benvenuto e riepilogo del sistema
B="\033[1;36m"; N="\033[0m"

banner() {
  printf "$B"
  cat <<'BANNER'
###### ###### ###### ###### ######  ##### ###### ###### ######
#    # #        ##   #    # #    # #      #    # #    # #
###### #####    ##   ###### #    # #      #    # ###### #####
#   #  #        ##   #   #  #    # #      #    # #   #  #
#   #  ######   ##   #   #  ######  ##### ###### #   #  ######

  RetroCore - distribuzione per PC vecchi, base Tiny Core
BANNER
  printf "$N"
}

summary() {
  cpu=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | sed 's/^ *//')
  kernel=$(uname -r)
  ram=$(free -m 2>/dev/null | awk '/^Mem:/{print $2}')

  echo ""
  echo "  Kernel : $kernel"
  [ -n "$cpu" ] && echo "  CPU    : $cpu"
  [ -n "$ram" ] && echo "  RAM    : ${ram} MB"
  echo ""
}

if [ "$1" = "--help" ]; then
  echo "Comandi utili di RetroCore:"
  echo "  retrocore-info     questo riepilogo"
  echo "  retrocore-wifi     collegarsi al WiFi"
  echo "  tce-load -wi X     installa un'estensione (es: tce-load -wi firefox)"
  echo "  filetool.sh -b     salva le impostazioni per il prossimo avvio"
  exit 0
fi

banner
summary
